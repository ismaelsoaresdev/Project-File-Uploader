<!-- views/fileDetails.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="stylesheet" href="/css/style.css">
  <meta charset="UTF-8">
  <title>File Details - <%= file.name %></title>
</head>
<body>
  <h1>File Details</h1>
  <p><strong>Name:</strong> <%= file.name %></p>
  <p><strong>Size:</strong> ${(file.size / 1024).toFixed(2)} KB</p>
  <p><strong>Uploaded at:</strong> <%= file.createdAt %></p>
  
  <br>
  <!-- Download Button -->
  <a href="/files/<%= file.id %>/download">
    <button>Download File</button>
  </a>

  <!-- Delete Button -->
  <form action="/files/<%= file.id %>/delete" method="POST" style="display:inline; margin-left: 10px;" onsubmit="return confirm('Are you sure you want to delete this file?');">
    <button type="submit" style="background-color: red; color: white;">Delete File</button>
  </form>
  
  <br><br>
  <a href="<%= backLink %>">← Back</a>
</body>
</html>